{
  "name": "@signalone/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript types, constants, and pure utilities. Domain-agnostic; no server-only code or secrets.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.2"
  }
}
