    "db:migrate:verify": "tsx scripts/db-migrate-verify.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:seed:demo": "tsx scripts/db-seed-demo.ts",
    "db:cleanup:e2e": "tsx scripts/db-cleanup-e2e.ts",
    "db:refresh": "tsx scripts/db-refresh.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1161.0",
    "@base-ui/react": "^1.9.0",
