# Copy to .env.local. Placeholders only: never commit real values.
# See /docs/environments.md for the full variable reference.

# --- Server-only (never expose to browser or mobile) ---
# Application environment: dev | qa | stage | prod
APP_ENV=dev
# Neon connection string for the database matching APP_ENV
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Clerk secret key (sk_test_... outside prod)
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# --- Client-safe (public; inlined into the browser bundle) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
