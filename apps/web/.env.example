# Copy to .env.local (gitignored). Placeholders only; never commit real values.
# See /docs/environment.md.

# --- Server-only (never prefix with NEXT_PUBLIC_) ---------------------------
# Logical environment of this app: dev | qa | stage | prod
# (optional; defaults to DATABASE_ENV)
APP_ENV=dev
# Logical environment that DATABASE_URL targets: dev | qa | stage | prod
DATABASE_ENV=dev
# Neon connection string for that environment
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Clerk secret key
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# --- Client-safe (exposed to the browser bundle) ----------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Optional display hint only; not authoritative
# NEXT_PUBLIC_APP_ENV=dev
