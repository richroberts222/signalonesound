{
  "name": "mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Signal One mobile app (React Native + Expo). Foundation shell only; no domain features.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:deps": "expo install --check",
    "export": "expo export --platform android --platform ios --output-dir dist"
  },
  "dependencies": {
    "@clerk/expo": "^4.9.0",
    "@signalone/shared": "workspace:*",
    "@signalone/validation": "workspace:*",
    "expo": "~57.0.27",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "~19.2.4",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
