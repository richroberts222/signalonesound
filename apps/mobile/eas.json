{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_APP_ENV": "dev" }
    },
    "qa": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_APP_ENV": "qa" }
    },
    "staging": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_APP_ENV": "stage" }
    },
    "production": {
      "env": { "EXPO_PUBLIC_APP_ENV": "prod" }
    }
  }
}
