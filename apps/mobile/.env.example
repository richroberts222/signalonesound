# Copy to .env.local (gitignored). EXPO_PUBLIC_* values are embedded in the app
# bundle and are PUBLIC. Never put DATABASE_URL, CLERK_SECRET_KEY, or any other
# secret here. See /docs/mobile.md and /docs/environment.md.

# dev | qa | stage | prod (explicit; never inferred)
EXPO_PUBLIC_APP_ENV=dev

# Signal One API base URL for this environment. From an Android emulator the
# host machine is http://10.0.2.2:3000; from a device use the host's LAN address.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional until the Clerk mobile integration is added (publishable key only).
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
